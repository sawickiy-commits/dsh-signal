{
  "name": "dsh-signal",
  "version": "1.1.0",
  "description": "Intelligent DeepSeek Peak/Off-Peak Tariff Monitor for DeepSeek Harness (RU/EN)",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "icon.svg",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "locales": [
    "ru",
    "en"
  ],
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "dsh-plugin",
    "peak",
    "off-peak",
    "pricing",
    "status",
    "tariff",
    "monitor"
  ],
  "license": "MIT",
  "author": "sawickiy-commits",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sawickiy-commits/dsh-signal.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
